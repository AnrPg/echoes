{
  "name": "@echoes/adapter-chatgpt-api",
  "version": "0.1.0",
  "description": "Parses ChatGPT web API responses (already fetched) into the normalized Echoes conversation tree. Parse-only: no network, no DOM, no tokens.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "fixture": "node scripts/anonymize-capture.ts",
    "docs": "typedoc"
  },
  "dependencies": {
    "@echoes/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typedoc": "^0.28.20",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  }
}
