{
  "$id": "https://raw.githubusercontent.com/AnrPg/echoes/main/packages/core/schemas/conversation.v1.schema.json",
  "title": "Echoes conversation (schemaVersion 1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "model": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "rootId": {
      "type": "string",
      "minLength": 1
    },
    "activeLeafId": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "childIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "tool",
              "system"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "blocks": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "markdown"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "code"
                    },
                    "lang": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "origin": {
                      "type": "string",
                      "enum": [
                        "fence",
                        "tool"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "text",
                    "origin"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "toolOutput"
                    },
                    "text": {
                      "type": "string"
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "fileId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "name": {
                            "type": "string"
                          },
                          "mime": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "pattern": "^https:\\/\\/"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "ok",
                              "expired",
                              "sandbox-gone",
                              "pending"
                            ]
                          }
                        },
                        "required": [
                          "fileId",
                          "status"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "reasoning"
                    },
                    "summary": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "summary"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "image"
                    },
                    "resource": {
                      "type": "object",
                      "properties": {
                        "fileId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string"
                        },
                        "mime": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "pattern": "^https:\\/\\/"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "expired",
                            "sandbox-gone",
                            "pending"
                          ]
                        }
                      },
                      "required": [
                        "fileId",
                        "status"
                      ],
                      "additionalProperties": false
                    },
                    "generated": {
                      "type": "boolean"
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "url"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "resource",
                    "generated"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "attachment"
                    },
                    "resource": {
                      "type": "object",
                      "properties": {
                        "fileId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string"
                        },
                        "mime": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "pattern": "^https:\\/\\/"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "ok",
                            "expired",
                            "sandbox-gone",
                            "pending"
                          ]
                        }
                      },
                      "required": [
                        "fileId",
                        "status"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "resource"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "citation"
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "url"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "canvas"
                    },
                    "title": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "title",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "unknown"
                    },
                    "contentType": {
                      "type": "string"
                    },
                    "raw": {}
                  },
                  "required": [
                    "kind",
                    "contentType",
                    "raw"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "hidden": {
            "type": "boolean"
          },
          "raw": {},
          "notFetched": {
            "type": "string",
            "enum": [
              "later-messages",
              "earlier-messages"
            ]
          }
        },
        "required": [
          "id",
          "parentId",
          "childIds",
          "role",
          "blocks",
          "hidden"
        ],
        "additionalProperties": false
      }
    },
    "lineage": {
      "type": "object",
      "properties": {
        "parentConversationId": {
          "type": "string",
          "minLength": 1
        },
        "forkNodeId": {
          "type": "string",
          "minLength": 1
        },
        "childConversationId": {
          "type": "string",
          "minLength": 1
        },
        "detectedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "evidence": {
          "type": "string",
          "enum": [
            "recorded",
            "inferred",
            "api-metadata"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "parentSnapshot": {
          "$ref": "#"
        }
      },
      "required": [
        "parentConversationId",
        "forkNodeId",
        "childConversationId",
        "detectedAt",
        "evidence",
        "confidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "createdAt",
    "updatedAt",
    "sourceUrl",
    "rootId",
    "activeLeafId",
    "nodes"
  ],
  "additionalProperties": false
}
