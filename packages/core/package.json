{
  "name": "@echoes/core",
  "version": "0.1.0",
  "description": "Normalized conversation model, tree traversal and a host-agnostic request scheduler for exporting chat conversations. Pure TypeScript: no network, no DOM.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./highlight": "./src/highlight.ts",
    "./schemas/*": "./schemas/*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./highlight": {
        "types": "./dist/highlight.d.ts",
        "default": "./dist/highlight.js"
      },
      "./schemas/*": "./schemas/*"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "schema": "node scripts/gen-schema.ts",
    "docs": "typedoc"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "markdown-it": "^14.1.0",
    "minisearch": "^7.2.0",
    "shiki": "^3.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.5",
    "typedoc": "^0.28.20",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  }
}
