        {
          "kind": "markdown",
          "text": "## Ποιον συνδυασμό να διαλέξεις;"
        },
        {
          "kind": "widget",
          "sourceFormat": "chatgpt-widget",
          "source": "{@body const mixes=[{name:\"Ήπιο, ιταλικό\",desc:\"Αναδεικνύει την ντομάτα και τα μανιτάρια.\",herbs:\"1 κλωνάρι θυμάρι + 1 δάφνη στο μαγείρεμα, 5 φύλλα φρέσκου βασιλικού στο τέλος.\"},{name:\"Ελληνικό, σπιτικό\",desc:\"Πιο οικείο, με καθαρή γεύση κοκκινιστού.\",herbs:\"1 δάφνη + 1 μικρό κλωνάρι σέλινο στο μαγείρεμα, 1 κ.σ. μαϊντανό στο τέλος.\"},{name:\"Πιο πράσινο και δροσερό\",desc:\"Δίνει μεγαλύτερη έμφαση στο σπανάκι και στο πλιγούρι.\",herbs:\"1 δάφνη στο μοσχάρι, 1 κ.γ. άνηθο στο πλιγούρι και 1 κ.σ. μαϊντανό στο σερβίρισμα.\"}]}\n{@body const [choice,setChoice]=DIL.useState(\"0\")}\n<box border radius=\"xl\" padding={3} gap={3}>\n  <radio-group direction=\"col\" value={choice} onChange={setChoice}>\n    {#each mixes as mix,i}\n      <radio value={String(i)}>\n        <box gap=\"2px\">\n          **{mix.name}**\n          <text color=\"secondary\" size=\"sm\">{mix.desc}</text>\n        </box>\n      </radio>\n    {/each}\n  </radio-group>\n  <divider color=\"subtle\"/>\n  <text weight=\"medium\" size=\"sm\">Τα μυρωδικά για τις 3 φέτες ποντικιού:</text>\n  {mixes[Number(choice)].herbs}\n</box>",
          "view": [
            {
              "type": "group",
              "direction": "column",
              "children": [
                {
                  "type": "choice",
                  "id": "choice",
                  "options": [
