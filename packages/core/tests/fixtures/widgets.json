          "source": "{@body const groups=[\n{title:\"Α. Για το μοσχαράκι κοκκινιστό\",items:[\"3 φέτες μοσχαρίσιο ποντίκι (περίπου 650–900 γρ. συνολικά, με κόκαλο)\",\"450 γρ. πασάτα ή τριμμένη ντομάτα\",\"1 μέτριο ξερό κρεμμύδι\",\"1 κ.σ. ελαιόλαδο\",\"1 φύλλο δάφνης\",\"1 μικρό κλωνάρι φρέσκο θυμάρι\",\"3–4 φύλλα φρέσκου βασιλικού\",\"300–450 ml ζεστό νερό, ή όσο χρειαστεί\",\"Αλάτι και φρεσκοτριμμένο πιπέρι\"]},\n{title:\"Β. Για τα χόρτα μέσα στη σάλτσα\",items:[\"40 γρ. φρέσκο σπανάκι\",\"20 γρ. βλίτα\",\"20 γρ. σέσκουλα (τρυφερά φύλλα)\"]},\n{title:\"Γ. Για το πλιγούρι με μανιτάρια\",items:[\"130 γρ. χοντρό πλιγούρι (ωμό)\",\"200 γρ. φρέσκα μανιτάρια\",\"1 κ.σ. ελαιόλαδο\",\"Περίπου 280–320 ml νερό ή ελαφρύ ζωμό μοσχαριού, ανάλογα με τη συσκευασία\",\"Λίγο αλάτι και πιπέρι\"]}]}\n{@body const [checked,setChecked]=DIL.useState([])}\n<box border radius=\"xl\" padding={3} gap={3}>\n  <row justify=\"between\" align=\"center\">\n    **Λίστα υλικών**\n    <text color=\"secondary\" size=\"xs\" tabularNums>{checked.length}/{groups.reduce((n,g)=>n+g.items.length,0)}</text>\n  </row>\n  {#each groups as g,gi}\n    <box gap={2} key={gi}>\n      <text weight=\"medium\">{g.title}</text>\n      {#each g.items as item,i}\n        <checkbox key={`${gi}-${i}`} checked={checked.includes(`${gi}-${i}`)} onChange={v=>setChecked(old=>v?[...old,`${gi}-${i}`]:old.filter(x=>x!==`${gi}-${i}`))}>{item}</checkbox>\n      {/each}\n    </box>\n  {/each}\n  <row justify=\"end\">\n    <button color=\"secondary\" variant=\"outline\" size=\"sm\" onClick={()=>setChecked([])}>Καθαρισμός λίστας</button>\n  </row>\n</box>",
