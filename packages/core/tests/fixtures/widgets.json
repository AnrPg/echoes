      "blocks": [
        {
          "kind": "markdown",
          "text": "Ποιον συνδυασμό να διαλέξεις;"
        },
        {
          "kind": "widget",
          "sourceFormat": "chatgpt-widget",
          "source": "{@body const mixes=[{name:\"Ήπιο, ιταλικό\",desc:\"Αναδεικνύει την ντομάτα.\",herbs:\"1 κλωνάρι θυμάρι + 1 δάφνη.\"},{name:\"Ελληνικό, σπιτικό\",desc:\"Πιο οικείο.\",herbs:\"1 δάφνη + σέλινο.\"}]} {@body const [choice,setChoice]=DIL.useState(\"0\")} <box border\nradius=\"xl\" padding={3} gap={3}> <radio-group direction=\"col\" value={choice}\nonChange={setChoice}> {#each mixes as mix,i} <radio value={String(i)}> <box\ngap=\"2px\"> {mix.name} <text color=\"secondary\" size=\"sm\">{mix.desc}</text>\n</box> </radio> {/each} </radio-group> <divider color=\"subtle\"/> <text\nweight=\"medium\" size=\"sm\">Τα μυρωδικά:</text>\n{mixes[Number(choice)].herbs} </box>",
          "view": [
            {
              "type": "group",
              "direction": "column",
              "children": [
                {
                  "type": "choice",
                  "id": "choice",
                  "options": [
                    {
                      "label": "Ήπιο, ιταλικό\n\nΑναδεικνύει την ντομάτα."
                    },
                    {
                      "label": "Ελληνικό, σπιτικό\n\nΠιο οικείο."
                    }
                  ],
                  "selected": 0
                },
                {
                  "type": "markdown",
                  "text": "---\n\nΤα μυρωδικά:"
                },
                {
                  "type": "switch",
                  "choice": "choice",
                  "cases": [
                    [
                      {
                        "type": "markdown",
                        "text": "1 κλωνάρι θυμάρι + 1 δάφνη."
                      }
                    ],
                    [
                      {
                        "type": "markdown",
                        "text": "1 δάφνη + σέλινο."
                      }
                    ]
                  ]
                }
              ]
            }
          ]
        },
        {
          "kind": "markdown",
          "text": "Θα διάλεγα τον πρώτο."
        }
      ],
      "hidden": false
    }
