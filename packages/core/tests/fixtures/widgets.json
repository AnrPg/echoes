        {
          "kind": "markdown",
          "text": "1. Υλικά"
        },
        {
          "kind": "widget",
          "sourceFormat": "chatgpt-widget",
          "source": "{@body const ingredients = [ {group:\"Κυρίως\",items:[\"3 φέτες ποντίκι\",\"1 κυδώνι\"]},\n{group:\"Ρύζι\",items:[\"120 γρ. μπασμάτι\"]}]} {@body\nconst [checked,setChecked] = DIL.useState([])} <box border radius=\"xl\" padding=\n{3} gap={3}> <row justify=\"between\" align=\"center\"> Λίστα αγορών\n<text color=\"secondary\" size=\"xs\" tabularNums>\n{checked.length}/{ingredients.reduce((n,g)=>n+g.items.length,0)}</text>\n</row> {#each ingredients as group, gi} <box gap={2} key={gi}> <text\nweight=\"medium\" color=\"default\">{group.group}</text> {#each group.items as\nitem, i} <checkbox key={`${gi}-${i}`} checked={checked.includes(`${gi}-${i}`)}\nonChange={v=>setChecked(old=>v?[...old,`${gi}-${i}`]:old.filter(x=>x!==`${gi}-${i}`))}>{item}</checkbox>\n{/each} </box> {/each} <row justify=\"end\"> <button size=\"sm\"\nvariant=\"outline\" color=\"secondary\" onClick={()=>setChecked([])}>Καθαρισμός\nεπιλογών</button> </row> </box>",
          "view": [
            {
              "type": "group",
              "direction": "column",
              "children": [
                {
                  "type": "group",
                  "direction": "row",
                  "children": [
                    {
                      "type": "markdown",
                      "text": "Λίστα αγορών"
                    },
                    {
                      "type": "counter"
                    }
                  ]
                },
                {
                  "type": "group",
                  "direction": "column",
                  "children": [
                    {
                      "type": "markdown",
                      "text": "Κυρίως"
                    },
                    {
                      "type": "checkbox",
                      "label": "3 φέτες ποντίκι",
                      "checked": false
                    },
                    {
                      "type": "checkbox",
                      "label": "1 κυδώνι",
                      "checked": false
                    }
                  ]
                },
                {
                  "type": "group",
                  "direction": "column",
                  "children": [
                    {
                      "type": "markdown",
                      "text": "Ρύζι"
                    },
                    {
                      "type": "checkbox",
                      "label": "120 γρ. μπασμάτι",
                      "checked": false
                    }
                  ]
                },
                {
                  "type": "group",
                  "direction": "row",
                  "children": [
                    {
                      "type": "reset",
                      "label": "Καθαρισμός επιλογών"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "kind": "markdown",
          "text": "2. Μοσχαράκι"
        }
