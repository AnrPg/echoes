        {
          "kind": "markdown",
          "text": "## Πόσο διακριτική θέλεις τη γεύση των χόρτων;"
        },
        {
          "kind": "widget",
          "sourceFormat": "chatgpt-widget",
          "source": "{@body const options=[{name:\"Σχεδόν ανεπαίσθητη\",spin:25,chard:15,endive:0,note:\"Η ντομάτα κυριαρχεί απολύτως. Μόνο μια υποψία πράσινης γεύσης.\"},{name:\"Διακριτική και ισορροπημένη\",spin:40,chard:25,endive:10,note:\"Αυτή προτείνω: ντομάτα μπροστά, χόρτα στο αρωματικό βάθος.\"},{name:\"Πιο αισθητή φυτική νότα\",spin:65,chard:45,endive:20,note:\"Τα χόρτα αναγνωρίζονται καθαρότερα, αλλά η ντομάτα παραμένει βασική.\"}]}\n{@body const [intensity,setIntensity]=DIL.useState(\"1\")}\n<box border radius=\"xl\" padding={3} gap={3}>\n  <radio-group direction=\"col\" value={intensity} onChange={setIntensity}>\n    {#each options as option,i}\n      <radio value={String(i)}>{option.name}</radio>\n    {/each}\n  </radio-group>\n  <divider color=\"subtle\"/>\n  <grid columns={3} gap={2}>\n    {#each [{n:\"Σπανάκι\",k:\"spin\"},{n:\"Σέσκουλα\",k:\"chard\"},{n:\"Αντίδια\",k:\"endive\"}] as item}\n      <grid-item>\n        <box background=\"surface-secondary\" radius=\"lg\" padding={3} align=\"center\" gap=\"3px\">\n          <title size=\"xl\" color=\"default\" tabularNums>{options[Number(intensity)][item.k]}<text color=\"secondary\" size=\"xs\"> γρ.</text></title>\n          <text size=\"xs\" color=\"secondary\">{item.n}</text>\n        </box>\n      </grid-item>\n    {/each}\n  </grid>\n  <text color=\"secondary\" size=\"sm\">{options[Number(intensity)].note}</text>\n</box>",
          "view": [
